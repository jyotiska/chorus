OLLAMA_HOST=http://localhost:11434
# CHORUS_DB=/absolute/path/to/sessions.sqlite3
# CHORUS_CATALOG=/absolute/path/to/catalog.json
CHORUS_API_URL=http://127.0.0.1:43187
CHORUS_PACING=1.8
# Required only for GPT-6-Luna; keep this credential in the backend.
CHORUS_API_KEY=
# Required only for models in the OpenRouter group.
OPENROUTER_API_KEY=
# GPT-5.6+ cache controls: implicit (default), explicit (stable instructions), disabled.
# The 30-minute TTL is used; longer paid retention is not enabled automatically.
CHORUS_OPENAI_CACHE_MODE=implicit
# Independent harness request capacity (workers remain independently runnable).
CHORUS_CLOUD_CONCURRENCY=4
CHORUS_LOCAL_CONCURRENCY=1
# Optional exact-route cost estimates. Values are USD per million tokens;
# entries require input, output, cached, cacheWrite, effectiveDate, source.
# CHORUS_RATES_JSON={"openrouter:MODEL_ID":{"input":1,"output":2,"cached":0.1,"cacheWrite":1.25,"effectiveDate":"2026-11-02","source":"provider rate card"}}

# Bundled starters are used unless a custom frontend/backend starter root is set.
# CHORUS_EXPERIMENT_SCAFFOLD=/absolute/path/to/starters
# CHORUS_EXPERIMENT_ROOT=/absolute/path/to/experiments
