  "components": {
    "schemas": {
      "APIError": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_MODEL_RESPONSE",
              "GENERATION_FAILED",
              "MODEL_UNAVAILABLE",
              "MODEL_NOT_FOUND",
              "MODEL_REQUEST_FAILED",
              "TIMEOUT",
              "CANCELLED",
              "CONTEXT_LIMIT",
              "NOT_FOUND",
              "CONFLICT",
              "INVALID_STATE",
              "CAPACITY",
              "RECOVERED",
              "VERSION_MISMATCH",
              "FORBIDDEN",
              "BACKEND_UNAVAILABLE"
            ],
            "title": "Code"
          },
          "requestId": {
            "type": "string",
            "title": "Requestid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "code",
          "requestId"
        ],
        "title": "APIError"
      },
      "Agent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "traits": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Traits"
          },
          "mood": {
            "type": "string",
            "title": "Mood",
            "default": "focused"
          },
          "energy": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Energy",
            "default": 80
          },
          "confidence": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 80
          },
          "personality": {
            "$ref": "#/components/schemas/Personality"
          },
          "collection": {
            "type": "string",
            "title": "Collection",
            "default": "nanoville"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "description",
          "traits",
          "mood",
          "energy",
          "confidence",
          "personality",
          "collection"
        ],
        "title": "Agent"
      },
      "Catalog": {
        "properties": {
          "agents": {
            "items": {
              "$ref": "#/components/schemas/Agent"
            },
            "type": "array",
            "title": "Agents"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "type": "array",
            "title": "Scenarios"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "type": "array",
            "title": "Models"
          },
          "defaultModel": {
            "type": "string",
            "title": "Defaultmodel"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agents",
          "scenarios",
          "models",
          "defaultModel"
        ],
        "title": "Catalog"
      },
      "Command": {
        "properties": {
          "commandId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Commandid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expectedrevision"
          },
          "action": {
            "type": "string",
            "enum": [
              "start",
              "pause",
              "resume",
              "stop"
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "commandId",
          "expectedRevision",
          "action"
        ],
        "title": "Command"
      },
      "FinalJudgement": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 600,
            "minLength": 8,
            "title": "Summary"
          },
          "strengths": {
            "items": {
              "type": "string",
              "maxLength": 300,
              "minLength": 8
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Strengths"
          },
          "improvements": {
            "items": {
              "type": "string",
              "maxLength": 300,
              "minLength": 8
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Improvements"
          },
          "nextPriorities": {
            "items": {
              "type": "string",
              "maxLength": 300,
              "minLength": 8
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Nextpriorities"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "Meets requirements",
              "Partially meets requirements",
              "Needs more work"
            ],
            "title": "Verdict"
          },
          "feedbackResponse": {
            "type": "string",
            "maxLength": 600,
            "minLength": 8,
            "title": "Feedbackresponse"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "type": "array",
            "minItems": 1,
            "title": "Requirements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "strengths",
          "improvements",
          "nextPriorities",
          "verdict",
          "feedbackResponse",
          "requirements"
        ],
        "title": "FinalJudgement"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
